# --- window ---
window-height = 50
window-width = 160
window-padding-y = 10
window-padding-x = 10
window-padding-balance = true
window-step-resize = true
window-colorspace = display-p3

# --- macOS chrome ---
macos-window-shadow = false
macos-titlebar-style = transparent
macos-non-native-fullscreen = visible-menu
macos-titlebar-proxy-icon = hidden

# --- transparency / blur (wallpaper shows through) ---
background-opacity = 0.7
background-blur = 20
unfocused-split-opacity = 0.7
background = #1a1420

# --- legibility over busy wallpaper ---
minimum-contrast = 1.1
alpha-blending = linear-corrected
font-thicken = false

# --- selection / splits ---
selection-background = #5e4a6b
selection-foreground = #f5e6f0
unfocused-split-fill = #1a1420

# --- palette ---
theme = Rose Pine Moon

# --- cursor ---
cursor-color = #e8a5c8
cursor-text = #000000
cursor-opacity = 0.9
cursor-style-blink = true

# --- font ---
font-feature = -calt
font-size = 13

# --- QoL ---
mouse-hide-while-typing = true

# --- pane (split) focus — vim-style ⌘ h/j/k/l ---
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right
# clear_screen lived on ⌘K (now split-focus left→up) → relocated to ⌘⇧K
keybind = super+shift+k=clear_screen

# --- pane (split) resize — vim-style ⌘ ⌃ h/j/k/l (by 10) ---
keybind = super+ctrl+h=resize_split:left,10
keybind = super+ctrl+j=resize_split:down,10
keybind = super+ctrl+k=resize_split:up,10
keybind = super+ctrl+l=resize_split:right,10
